<?xml version="1.0" encoding="utf-8"?>
<!-- The Google Play build: leaves out what Play restricts. Play updates the app itself, so it doesn't install APKs,
     and it doesn't list every installed app; it only asks to see apps with home-screen widgets (for the battery widget). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:node="remove" />

    <!-- The apps of car makers that show a battery level in a home-screen widget (EvCars / EvWidget). Play hides every other
         installed app from the widget list, so each maker's app is named here. Only the apps listed are visible. -->
    <queries>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <!-- Volkswagen -->
        <package android:name="com.volkswagen.weconnect" />
        <!-- Audi -->
        <package android:name="de.myaudi.mobile.assistant" />
        <!-- Porsche -->
        <package android:name="com.porsche.one" />
        <!-- Škoda -->
        <package android:name="cz.skodaauto.myskoda" />
        <!-- BMW (North America variant; the European app is not confirmed yet) -->
        <package android:name="de.bmw.connected.mobile20.na" />
        <!-- Mercedes-Benz (Europe; USA variant: com.mbusa.mmusa.android) -->
        <package android:name="com.daimler.ris.mercedesme.ece" />
        <package android:name="com.mbusa.mmusa.android" />
        <!-- Ford -->
        <package android:name="com.ford.fordpass" />
        <!-- Volvo -->
        <package android:name="se.volvo.vcc" />
        <!-- Toyota -->
        <package android:name="com.toyota.oneapp" />
        <!-- Hyundai (MyHyundai with Bluelink, USA) -->
        <package android:name="com.stationdm.bluelink" />
        <!-- Kia (Kia Access, USA; the European Kia Connect app is not confirmed yet) -->
        <package android:name="com.myuvo.link" />
        <!-- Peugeot -->
        <package android:name="com.psa.mym.mypeugeot" />
        <!-- Opel -->
        <package android:name="com.psa.mym.myopel" />
        <!-- Renault -->
        <package android:name="com.myrsm.android" />
        <!-- Cupra -->
        <package android:name="com.cupra.mycupra" />
        <!-- Nissan -->
        <package android:name="com.nissan.mynissan" />
        <!-- Mazda -->
        <package android:name="com.interrait.mymazda" />
        <!-- Polestar -->
        <package android:name="com.polestar.explore" />
        <!-- Tesla -->
        <package android:name="com.teslamotors.tesla" />
        <!-- Citroën -->
        <package android:name="com.psa.mym.mycitroen" />
        <!-- Fiat (North America variant) -->
        <package android:name="com.fca.myconnect.fiat.nafta" />
        <!-- Ram (North America variant) -->
        <package android:name="com.fca.myconnect.ram.nafta" />
        <!-- Lexus -->
        <package android:name="com.lexus.oneapp" />
        <!-- Honda -->
        <package android:name="com.honda.hondalink.connect" />
        <!-- MINI (North America variant) -->
        <package android:name="de.mini.connected.mobile20.na" />
        <!-- Subaru -->
        <package android:name="com.subaru.telematics.app.remote" />
        <!-- Mitsubishi -->
        <package android:name="com.mitsubishi_motors.mitsubishimotors" />
        <!-- Genesis -->
        <package android:name="com.stationdm.genesis" />
        <!-- Chevrolet -->
        <package android:name="com.gm.chevrolet.nomad.ownership" />
        <!-- Land Rover -->
        <package android:name="com.jlr.landrover.incontrolremote.appstore" />
        <!-- Rivian -->
        <package android:name="com.rivian.android.consumer" />
        <!-- Kia (Europe; USA: com.myuvo.link) -->
        <package android:name="com.kia.connect.eu" />
        <!-- Hyundai (Europe; USA: com.stationdm.bluelink) -->
        <package android:name="com.hyundai.oneapp.eu" />
        <!-- Dacia (France; a separate app from Renault's) -->
        <package android:name="com.dacia.mydacia.one.fr" />
        <!-- Fiat (Europe; North America: com.fca.myconnect.fiat.nafta) -->
        <package android:name="com.fca.myconnect.fiat" />
        <!-- MG (Europe, MG iSMART) -->
        <package android:name="com.saicmotor.iov.europe" />
        <!-- Jeep (North America) -->
        <package android:name="com.fca.myconnect.nafta" />
        <!-- Alfa Romeo (North America) -->
        <package android:name="com.fca.myconnect.alfaromeo.nafta" />
        <!-- Maserati (North America) -->
        <package android:name="com.fca.myconnect.maseraticonnect.nafta" />
        <!-- Cadillac -->
        <package android:name="com.gm.cadillac.nomad.ownership" />
        <!-- Buick -->
        <package android:name="com.gm.buick.nomad.ownership" />
        <!-- Lynk & Co -->
        <package android:name="com.lynkco.global" />
        <!-- Lincoln -->
        <package android:name="com.lincoln.lincolnway" />
        <!-- Acura -->
        <package android:name="com.acura.acuralink.connect" />
        <!-- Infiniti -->
        <package android:name="com.infiniti.myinfiniti" />
        <!-- Lotus -->
        <package android:name="com.lotus.carsdomestic.intl" />
        <!-- XPENG -->
        <package android:name="com.xiaopeng.globalcarinfo" />
        <!-- NIO -->
        <package android:name="com.nio.nioapp" />
        <!-- Zeekr -->
        <package android:name="com.zeekr.global" />
        <!-- Suzuki (Japan; other markets not confirmed) -->
        <package android:name="suzuki.app.A017.SzkCnnctJp" />
    </queries>
</manifest>
