<?xml version="1.0" encoding="utf-8"?>
<!-- GitHub build only: the whole phone app also on the Android Auto screen (Android 15+, "Unbekannte Quellen" on),
     the way AABrowser does it. Google Play rejects CAR_LAUNCHER next to the car app metadata, so the play flavor leaves it out.
     The template navigation (CarNavService, head-up display arrows) stays as it is. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="com.headunit.launcher.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.CAR_LAUNCHER" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
                <category android:name="android.intent.category.APP_MAPS" />
            </intent-filter>
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
        <meta-data android:name="distractionOptimized" android:value="true" />
    </application>
</manifest>
